# Copy to .env and fill in real values. NEVER commit .env.

# Postgres (Supabase in production, docker-compose db locally)
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<SUPABASE_HOST>:5432/postgres

# Redis (Upstash in production — note the TLS scheme 'rediss://')
REDIS_URL=rediss://default:<YOUR_UPSTASH_TOKEN>@<UPSTASH_HOST>:6379

# Streamlit frontend -> FastAPI backend
API_URL=https://resume-api-femi.fly.dev

# Streamlit login credentials (LEGACY fallback only — used when the API is
# unreachable. Real accounts are created via the Sign Up page.)
HR_PASSWORD=change-me
RECRUITER_PASSWORD=change-me-too
COOKIE_KEY=random-long-string-for-cookie-signing

# Auth token signing (production: long random string!)
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
TOKEN_MAX_AGE_DAYS=7

# Admin dashboard access: comma-separated usernames that get admin rights.
# Sign up with one of these usernames (or flip users.is_admin in the DB).
ADMIN_USERNAMES=admin

# API CORS lock-down (optional). Comma-separated allowed origins for the UI.
# Leave unset for the permissive demo default ("*").
# CORS_ALLOW_ORIGINS=https://resume-streamlit.onrender.com