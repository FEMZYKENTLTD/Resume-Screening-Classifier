# Copy to .env and fill in real values. NEVER commit .env.

# Postgres (Supabase in production, docker-compose db locally)
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<SUPABASE_HOST>:5432/postgres

# Redis (Upstash in production — note the TLS scheme 'rediss://')
REDIS_URL=rediss://default:<YOUR_UPSTASH_TOKEN>@<UPSTASH_HOST>:6379

# Streamlit frontend -> FastAPI backend
API_URL=https://resume-api-femi.fly.dev

# Streamlit login credentials (LEGACY fallback only — used when the API is
# unreachable. Real accounts are created via the Sign Up page.)
HR_PASSWORD=change-me
RECRUITER_PASSWORD=change-me-too
COOKIE_KEY=random-long-string-for-cookie-signing

# Auth token signing. MUST be set to a long random string in production.
#
# Session tokens are signed with this value, so anyone who knows it can mint a
# token for ANY user id (including an admin). Leaving it unset, empty, or at
# the placeholder below makes the API sign with a RANDOM per-process key
# instead of a predictable one -- safe, but every restart logs all users out,
# and a CRITICAL line is written to the logs at boot. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
TOKEN_MAX_AGE_DAYS=7

# Admin dashboard access. These lists GRANT admin at signup/login — they never
# demote an account that was granted admin in the database or via the Admin UI
# (that silent demotion was the "my admin account isn't admin" bug).
ADMIN_USERNAMES=admin
# ADMIN_EMAILS=you@example.com
# If the instance has NO admin at all, promote the oldest (owner) account on
# login. Set to 0 to disable.
ADMIN_BOOTSTRAP_FIRST_USER=1
# Opt back into "mirror the lists exactly" (demotes anyone not listed).
# ADMIN_STRICT_SYNC=0
# Break glass, no admin left:
#   DATABASE_URL=... python scripts/grant_admin.py --username <you>

# API CORS lock-down (optional). Comma-separated allowed origins for the UI.
# Leave unset for the permissive demo default ("*").
# CORS_ALLOW_ORIGINS=https://resume-streamlit.onrender.com
# Duplicate-detection namespace for identical (resume + JD) submissions.
#   user   (default) — each ACCOUNT gets its own analysis row: the same file
#                      re-uploaded by the same account is still a cache hit,
#                      but a different user's run always lands in THEIR
#                      history (fixes "history is not updating").
#   global — legacy: one row per unique file+JD instance-wide.
#   off    — never short-circuit; record every single run (demo mode).
# DEDUP_SCOPE=user

# --- Database resilience ---
# Seconds before a DB connection attempt fails. Without this a paused
# database (e.g. Supabase free tier) hangs requests until the proxy returns
# an empty 502 — the exact thing that crashed the Admin dashboard.
# DB_CONNECT_TIMEOUT=10
# DB_POOL_RECYCLE=280

# --- Diagnostics / resilience ---
# Echo the exception type+message in 5xx bodies while debugging. Keep OFF in
# production: responses stay generic and full tracebacks go to the server log.
# DEBUG_ERRORS=1
# Server log verbosity for the API (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
# Seconds the Streamlit UI waits on /single_analyze. Raise it if cold Fly
# machines need longer to import spaCy/sklearn on the first request.
API_ANALYZE_TIMEOUT=120

# UI health probe: how patient the frontend is with a cold API before it
# declares the backend offline (retries are what stopped users being dumped
# on the legacy login form mid-session).
API_HEALTH_TIMEOUT=12
API_HEALTH_RETRIES=3
# Set to 0 on deployments whose accounts all live in the API/database, so the
# UI never shows the legacy env-credential login.
ALLOW_LEGACY_LOGIN=1
