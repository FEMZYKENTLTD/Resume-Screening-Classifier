FROM python:3.12-slim
WORKDIR /app

# See Dockerfile.api — no wheels-linux/ COPY (it is git-ignored and would
# break remote Fly builds).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
       spacy==3.8.16 \
       scikit-learn==1.9.0 \
       https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

COPY . .

# Requires DATABASE_URL + REDIS_URL in the environment (fly secrets / compose).
# concurrency=1 keeps resident memory well inside the 1GB machine.
CMD ["celery", "-A", "tasks", "worker", "--loglevel=INFO", "--concurrency=1"]
