FROM python:3.12-slim
WORKDIR /app

# Pinned requirements keep builds reproducible; PyPI serves everything at
# build time (the optional 'wheels-linux/' mirror is local-only and git-ignored,
# so it must NOT be COPYed here or remote builds fail).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
       spacy==3.8.16 \
       scikit-learn==1.9.0

# The NER model is installed by a resilient script: GitHub's release-asset CDN
# is frequently blocked even where github.com is reachable, and NER is an
# OPTIONAL extra with a regex fallback — it must never fail the whole build.
# Set --build-arg SPACY_MODEL_REQUIRED=1 to hard-fail the build instead of
# shipping without NER.
ARG SPACY_MODEL_REQUIRED=0
COPY scripts/install_spacy_model.sh /tmp/install_spacy_model.sh
RUN chmod +x /tmp/install_spacy_model.sh \
    && SPACY_MODEL_REQUIRED="$SPACY_MODEL_REQUIRED" /tmp/install_spacy_model.sh

COPY . .
COPY wait-for-db.sh /wait-for-db.sh
RUN chmod +x /wait-for-db.sh

EXPOSE 8000
CMD ["/wait-for-db.sh"]
