FROM python:3.12-slim
WORKDIR /app

# No wheels-linux/ COPY — it is git-ignored, so it does not exist in
# Render/Git remote build contexts. PyPI serves everything.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN mkdir -p /app/.streamlit && cp streamlit_app.toml /app/.streamlit/config.toml

EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]